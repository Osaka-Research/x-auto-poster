{
  "manifest_version": 3,
  "name": "X Post Queue",
  "version": "1.1.0",
  "description": "Draft and schedule posts locally, auto-post them to X (x.com) when due and the browser is open.",
  "permissions": ["storage", "unlimitedStorage", "alarms", "scripting", "tabs"],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "https://*.trycloudflare.com/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "X Post Queue"
  }
}
